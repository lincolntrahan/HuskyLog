{
  "name": "huskylog",
  "productName": "HuskyLog",
  "version": "0.1.7",
  "description": "Offline flight-test log, video and data review for ArduPilot DataFlash logs",
  "license": "MIT",
  "author": "HuskyLog contributors",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "node scripts/e2e.mjs",
    "gen:testdata": "node scripts/gen-test-video.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "e2e:phase1": "node scripts/e2e-phase1.mjs",
    "e2e:phase2": "node scripts/e2e-phase2.mjs",
    "e2e:phase3": "node scripts/e2e-phase3.mjs",
    "gen:model": "node scripts/gen-plane-model.mjs",
    "e2e:phase4": "node scripts/e2e-phase4.mjs",
    "e2e:phase5": "node scripts/e2e-phase5.mjs",
    "e2e:phase6": "node scripts/e2e-phase6.mjs",
    "e2e:phase7": "node scripts/e2e-phase7.mjs",
    "gen:syncvideo": "node scripts/gen-sync-video.mjs",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "e2e:ux": "node scripts/e2e-ux.mjs",
    "bench:export": "node scripts/bench-export.mjs",
    "e2e:features": "node scripts/e2e-features.mjs",
    "e2e:features2": "node scripts/e2e-features2.mjs",
    "e2e:sticks": "node scripts/e2e-sticks.mjs",
    "e2e:ux3": "node scripts/e2e-ux3.mjs"
  },
  "devDependencies": {
    "@cesium/core": "^0.1.1",
    "@cesium/engine": "^26.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cesium": "^1.147.0",
    "dockview": "^8.9.0",
    "dockview-react": "^8.9.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "mp4box": "^2.5.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "uplot": "^1.6.32",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller": false
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
