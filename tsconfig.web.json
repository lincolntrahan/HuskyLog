{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@core/*": ["./src/core/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/core/**/*", "src/preload/api.d.ts"],
  "exclude": ["**/*.test.ts", "src/core/**/testing/**"]
}
